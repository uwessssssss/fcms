<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fcms.Api</RootNamespace>
    <!-- Warnings are errors. A nullable warning in code that moves money is a
         bug that has not happened yet. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- XML docs feed Swagger: the /// summaries on every service become the
       descriptions in the UI, so the reasoning lives in one place. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.3" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.8" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="8.0.1" />
    <!-- Swagger. Pinned: 6.6.2 is the last line that targets net8.0 without

         dragging in the ASP.NET 9 metapackage. -->

    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />

  </ItemGroup>

</Project>
