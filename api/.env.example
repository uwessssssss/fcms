# Secrets live here, never in appsettings.json.
# v1 committed its database password and JWT signing key; both are in that
# repo's history permanently and should be rotated.

# NOTE: no spaces anywhere in this value. "Maximum Pool Size=25" is valid
# Npgsql, but any shell that word-splits the file will cut the string in half
# and you get "Format of the initialization string does not conform to
# specification starting at index 76". MaxPoolSize means the same thing and
# cannot be split.
#
# Port must match YOUR server. If you are running the Docker container from
# RUNNING.md it is 5544, not the 5432 default.
FCMS_DB="Host=localhost;Port=5544;Database=fcms;Username=fcms_app;Password=change_this_now;MaxPoolSize=25"

# At least 32 characters. Generate with: openssl rand -base64 48
Auth__SigningKey="CHANGE_ME_generate_with_openssl_rand_base64_48"

# Show an unrecognised database error in full on screen (table, constraint,
# function). Useful while testing; set to false before real stations use it.
# The server log always has the full detail, under the reference shown.
Errors__ShowDatabaseDetail=true
