# deploy/.env -- secrets for the dev server. Never commit the filled-in copy.
# Letters and digits only in the passwords (they sit inside a connection string).

# Where people open it.
#   A domain you point at this machine (A record):  SITE_ADDRESS=fcms-demo.example.com
#                                                   PUBLIC_URL=https://fcms-demo.example.com
#   Your own machine only:                          SITE_ADDRESS=localhost
#                                                   PUBLIC_URL=https://localhost
#   A bare server IP, no domain (plain HTTP):       SITE_ADDRESS=:80
#                                                   PUBLIC_URL=http://203.0.113.10
SITE_ADDRESS=localhost
PUBLIC_URL=https://localhost

# openssl rand -hex 24
POSTGRES_PASSWORD=
FCMS_APP_PASSWORD=
# openssl rand -base64 48   (at least 32 characters)
AUTH_SIGNING_KEY=

# The password every demo operator signs in with (SUP01, MGR01, ACC01, HO01, SYSADMIN ...).
DEMO_PASSWORD=
